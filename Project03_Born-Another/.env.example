# BORN ANOTHER — language interpreter (server-side only).
# Copy this file to .env.local (git-ignored), fill in ONE key, restart `npm run dev`.
# Never prefix these with VITE_ — VITE_* variables are bundled into the browser.

# Which interpreter: openai | anthropic | gemini | mock | local
#   mock  = fixed answers for the test sentences, no network, no cost
#   local = the rule-based keyword parser, offline
BA_AI_PROVIDER=openai

# Model id. Leave empty for the provider default:
#   openai → gpt-5.4-mini   anthropic → claude-haiku-5-5   gemini → gemini-3.5-flash-lite
BA_AI_MODEL=
# API keys (only the one for your provider is needed)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Safety valves
BA_AI_TIMEOUT_MS=8000
BA_AI_MAX_INPUT_CHARS=500
# When the provider fails (no key, timeout, error): local | neutral
BA_AI_FALLBACK=local
# Optional, OpenAI reasoning models only (e.g. minimal, low)
BA_AI_REASONING_EFFORT=
